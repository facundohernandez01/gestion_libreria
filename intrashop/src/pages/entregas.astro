---
import "../styles/global.css";
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Comandas · IntraShop</title></head>
<body>
<header class="topbar"><a href="/intrashop/" class="brand"><img src="/intrashop-logo.svg" width="40" height="40" alt=""/> IntraShop</a><a href="/intrashop/admin" class="admin-back">Configuración</a></header>
<main class="admin-main">
<div class="admin-heading"><span class="section-kicker">OPERACIÓN EN TIEMPO REAL · LAN</span><h1>Comandas y entregas</h1><p>Pedidos cobrados que esperan preparación o retiro. El cobro y la entrega son estados independientes.</p></div>
<section class="login-panel" id="login-panel" aria-labelledby="login-title">
  <div class="login-intro"><span class="section-kicker">ACCESO DEL PERSONAL</span><h2 id="login-title">Iniciar sesión</h2><p>Ingresá con el usuario y la contraseña de tu POS. Solo el personal autorizado puede gestionar entregas.</p></div>
  <form id="login-form" class="login-fields">
    <label for="login-user">Usuario POS<input id="login-user" name="usuario" autocomplete="username" required placeholder="Ingresá tu usuario"/></label>
    <label for="login-pass">Contraseña<input id="login-pass" name="clave" type="password" autocomplete="current-password" required placeholder="Ingresá tu contraseña"/></label>
    <button id="login-button" type="submit" class="primary-button">Ingresar a comandas</button>
  </form>
  <p id="connection" class="login-status" role="status" aria-live="polite">Completá tus credenciales para ingresar.</p>
</section>
<section class="operator-panel" id="operator-panel" hidden>
  <div><strong>Sesión de operador</strong><p id="session-user">Sesión activa</p></div>
  <label>Responsable de entrega<input id="operator" placeholder="Nombre del operador" autocomplete="off"/></label>
  <button id="logout-button" type="button" class="cancel-button">Cerrar sesión</button>
</section>
<section class="notifications-panel" aria-label="Avisos de nuevos pedidos">
  <div><strong>Avisos de pedidos nuevos (opcional)</strong><p>Permite mostrar una notificación del navegador cuando llega una nueva comanda. No es necesario activarlo para preparar o entregar pedidos. Funciona mientras esta página permanezca abierta y el navegador lo permita.</p></div>
  <button id="notifications" type="button" class="cancel-button" title="Permitir avisos del navegador">Permitir avisos</button>
</section>
<p class="delivery-help">En preparación: pedidos cobrados pendientes de entregar. Entregados: historial de pedidos ya retirados. Para operar una comanda, primero seleccioná «Tomar comanda».</p><div class="delivery-tabs" role="tablist"><button data-filter="activos" class="active" title="Pedidos cobrados aún no entregados">Pendientes de entrega <b id="active-count">0</b></button><button data-filter="entregado" title="Historial de pedidos entregados">Historial de entregas</button></div>
<div id="delivery-loading" class="delivery-loading" hidden><span class="delivery-spinner"></span><span id="loading-label">Consultando comandas…</span></div><div id="orders" class="delivery-grid" aria-live="polite"></div>
</main>
<script>
      const makeId = () => typeof crypto !== "undefined" && typeof crypto.randomUUID === "function" ? crypto.randomUUID() : "terminal-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 12);
type Item={descripcion:string;cantidad:number;subtotal:number};
type Order={id:number;venta_id:number;estado:string;fecha_creacion:string;total:number;items:Item[];entregado_por:string|null;tomado_por:string|null;tomado_terminal:string|null};
const $=(s:string)=>document.querySelector<HTMLElement>(s)!;
const storedBase=localStorage.getItem("intrashop_api");
const base=(location.port==="8000"?location.origin:((storedBase&&!storedBase.includes("localhost")&&!storedBase.includes("127.0.0.1")?storedBase:"")||import.meta.env.PUBLIC_POS_URL||(location.protocol+"//"+location.hostname+":8000"))).replace(/\/$/,"");
let token="";let authenticatedUser="";
let terminalId=localStorage.getItem("intrashop_delivery_terminal_id");
if(!terminalId){terminalId=makeId();localStorage.setItem("intrashop_delivery_terminal_id",terminalId);}
let filter="activos",first=true,seen=new Set<number>(),busy=false;
function loading(on:boolean,label="Consultando comandas…"){$("#delivery-loading").hidden=!on;$("#loading-label").textContent=label;}
function status(message:string,kind="info"){$("#connection").textContent=message;$("#connection").dataset.state=kind;}
async function responseError(response:Response){const data=await response.json().catch(()=>({}));return typeof data.detail==="string"?data.detail:("Error HTTP "+response.status);}
const labels:Record<string,string>={pendiente:"Pendiente de preparación",preparando:"Preparando",listo:"Listo para retirar",entregado:"Entregado"};
const money=(n:number)=>new Intl.NumberFormat("es-AR",{style:"currency",currency:"ARS"}).format(n);
const escape=(s:string)=>s.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]||c));
async function api(path:string,options:RequestInit={}){const response=await fetch(base+path,{...options,signal:AbortSignal.timeout(8000),headers:{"Authorization":"Bearer "+token,"X-Terminal-Id":terminalId ?? "","Content-Type":"application/json",...(options.headers||{})}});if(!response.ok)throw Error(await responseError(response));return response.json();}
function alertNew(n:number){if(n<1)return;try{if(Notification.permission==="granted")new Notification("IntraShop · Pedido nuevo",{body:n+" comanda(s) para preparar"});}catch{}}
async function load(){
if(!token){status("Iniciá sesión con tu usuario POS para ver las comandas.");return;}
if(busy)return;busy=true;loading(true);
try{
const data=await api("/tienda/admin/entregas") as Order[];
const active=data.filter(o=>o.estado!=="entregado");
const next=new Set(active.map(o=>o.id));
if(!first)alertNew(active.filter(o=>!seen.has(o.id)).length);
seen=next;first=false;
$("#active-count").textContent=String(active.length);
status("Conectado · actualizado "+new Date().toLocaleTimeString("es-AR"),"success");
const visible=filter==="activos"?active:data.filter(o=>o.estado==="entregado");
$("#orders").innerHTML=visible.length?visible.map(o=>{
let nextState=o.estado==="pendiente"?"preparando":o.estado==="preparando"?"listo":o.estado==="listo"?"entregado":"";
const action=o.estado==="pendiente"?"Iniciar preparación":o.estado==="preparando"?"Marcar listo":o.estado==="listo"?"Confirmar entrega":"";
if(o.estado!=="entregado"&&!o.tomado_por){nextState="tomar";}
if(o.tomado_por&&(o.tomado_por!==authenticatedUser||o.tomado_terminal!==terminalId)){nextState="";}
return '<article class="delivery-card '+o.estado+'"><div class="delivery-head"><div><small>COMANDA #'+o.venta_id+'</small><h2>'+labels[o.estado]+'</h2></div><strong>'+money(o.total)+'</strong></div><div class="delivery-items">'+o.items.map(i=>'<div><span><b>'+i.cantidad+' ×</b> '+escape(i.descripcion)+'</span><strong>'+money(i.subtotal)+'</strong></div>').join("")+'</div><div class="delivery-foot"><small>'+escape(o.fecha_creacion)+'</small>'+(nextState?'<button class="primary-button" data-id="'+o.id+'" data-next="'+nextState+'">'+(nextState==='tomar'?'Tomar comanda':action)+'</button>':'<span>Retirado por '+escape(o.entregado_por||"operador")+'</span>')+'</div></article>';
}).join(""):'<div class="empty-state"><h3>No hay pedidos en esta vista</h3><p>Las comandas aparecen cuando Mercado Pago confirma un cobro.</p></div>';
}catch(e){status("No se pudieron cargar las comandas: "+(e as Error).message,"error");}finally{busy=false;loading(false);}
}
$("#login-form").addEventListener("submit",async event=>{event.preventDefault();
const loginButton=document.querySelector<HTMLButtonElement>("#login-button")!;loginButton.disabled=true;loginButton.textContent="Validando…";loading(true,"Validando usuario…");status("Conectando al servidor POS…");
try{
const response=await fetch(base+"/pos/auth/login",{method:"POST",signal:AbortSignal.timeout(8000),headers:{"Content-Type":"application/json","X-Terminal-Id":terminalId ?? ""},
body:JSON.stringify({usuario:(document.querySelector<HTMLInputElement>("#login-user")!).value,clave:(document.querySelector<HTMLInputElement>("#login-pass")!).value})});
if(!response.ok)throw Error(response.status===401?"Usuario o contraseña incorrectos en el servidor POS":await responseError(response));
const data=await response.json();token=data.access_token;authenticatedUser=data.usuario;
(document.querySelector<HTMLInputElement>("#operator")!).value=data.usuario;
(document.querySelector<HTMLInputElement>("#login-pass")!).value="";
$("#login-panel").hidden=true;$("#operator-panel").hidden=false;$("#session-user").textContent="Conectado como "+authenticatedUser;
await load();
}catch(e){status("No se pudo iniciar sesión: "+(e as Error).message,"error");}finally{loginButton.disabled=false;loginButton.textContent="Iniciar sesión";loading(false);}
});
$("#logout-button").addEventListener("click",async()=>{try{await api("/pos/auth/logout",{method:"POST"});}catch{}token="";authenticatedUser="";$("#login-panel").hidden=false;$("#operator-panel").hidden=true;$("#orders").innerHTML="";$("#active-count").textContent="0";status("Sesión cerrada.");});
$("#orders").addEventListener("click",async e=>{
const btn=(e.target as HTMLElement).closest<HTMLButtonElement>("button[data-id]");if(!btn)return;
const operator=(document.querySelector<HTMLInputElement>("#operator")!).value.trim();
if(!operator){alert("Ingresá el nombre del operador para registrar la entrega.");return;}
if(btn.dataset.next==="entregado"&&!confirm("¿Confirmás que entregaste todos los artículos al cliente?"))return;
btn.disabled=true;const previous=btn.textContent;btn.textContent="Guardando…";
try{
if(btn.dataset.next==="tomar"){await api("/tienda/admin/entregas/"+btn.dataset.id+"/tomar",{method:"POST"});}
else{await api("/tienda/admin/entregas/"+btn.dataset.id,{method:"PATCH",body:JSON.stringify({estado:btn.dataset.next,operador:operator})});}
await load();}
catch(e){status("No se pudo actualizar la comanda: "+(e as Error).message,"error");btn.disabled=false;btn.textContent=previous;}
});
document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach(b=>b.addEventListener("click",()=>{filter=b.dataset.filter||"activos";document.querySelectorAll("[data-filter]").forEach(t=>t.classList.remove("active"));b.classList.add("active");load();}));
$("#notifications").addEventListener("click",async()=>{if(!("Notification" in window)){alert("Este navegador no admite notificaciones del sistema.");return;}const result=await Notification.requestPermission();$("#notifications").textContent=result==="granted"?"Notificaciones: activadas":"Notificaciones: bloqueadas";status(result==="granted"?"Recibirás avisos de nuevas comandas mientras esta página esté abierta.":"El navegador no permitió las notificaciones.",result==="granted"?"success":"info");});
status("Completá tus credenciales para ingresar.");setInterval(()=>{if(token)void load();},5000);
</script>
<style>
.delivery-toolbar{display:flex;align-items:end;gap:15px;flex-wrap:wrap;margin:24px 0}.delivery-toolbar label{font-size:12px;font-weight:700;color:#334263;display:grid;gap:8px}.delivery-toolbar input{border:1px solid #dce4f1;border-radius:12px;padding:12px;font-size:14px}.delivery-toolbar .cancel-button{width:auto;margin:0}.delivery-toolbar>span{font-size:12px;color:#667895;padding-bottom:10px}.delivery-tabs{display:flex;gap:10px;margin:20px 0}.delivery-tabs button{border:1px solid #dce4f1;border-radius:12px;padding:12px 20px;background:white;font-weight:700;color:#5e6c86}.delivery-tabs button.active{background:#0c2456;color:#fff}.delivery-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));gap:18px}.delivery-card{background:#fff;border:1px solid #e2e8f4;border-left:6px solid #e9b326;border-radius:18px;padding:20px;box-shadow:0 12px 30px #0b25500c}.delivery-card.preparando{border-left-color:#557bf4}.delivery-card.listo{border-left-color:#17a883}.delivery-card.entregado{border-left-color:#aeb8c9;opacity:.8}.delivery-head{display:flex;justify-content:space-between;gap:12px}.delivery-head small{color:#8290aa;font-weight:700}.delivery-head h2{font-size:17px;color:#182c54;margin:8px 0}.delivery-head>strong{color:#122550;white-space:nowrap}.delivery-items{margin:14px 0;border-top:1px solid #edf1f7;border-bottom:1px solid #edf1f7;padding:8px 0}.delivery-items>div{display:flex;justify-content:space-between;gap:12px;padding:9px 0;font-size:13px}.delivery-items b{color:#1a68e8}.delivery-foot{display:flex;align-items:center;justify-content:space-between;gap:10px}.delivery-foot small{color:#8490a8}.delivery-foot .primary-button{padding:11px 15px;font-size:12px}
.delivery-help{color:#52647d;font-size:13px;line-height:1.6;max-width:900px}.delivery-loading{display:flex;align-items:center;gap:10px;padding:12px 16px;border:1px solid #dce4f1;border-radius:12px;background:#f7faff;color:#27466c;font-weight:600;margin:12px 0}.delivery-loading[hidden]{display:none}.delivery-spinner{width:18px;height:18px;border:3px solid #c9d8f2;border-top-color:#316be2;border-radius:50%;animation:delivery-spin .8s linear infinite}@keyframes delivery-spin{to{transform:rotate(360deg)}}#connection[data-state="error"]{color:#b42318}#connection[data-state="success"]{color:#168060}.delivery-toolbar button:disabled,.delivery-foot button:disabled{opacity:.6;cursor:wait}
.login-panel{display:grid;grid-template-columns:1fr 1fr;gap:24px;background:#fff;border:1px solid #dce4f1;border-radius:20px;padding:26px;margin:24px 0;box-shadow:0 12px 32px #142a4810}.login-intro h2{margin:8px 0;color:#172b52}.login-intro p,.notifications-panel p,.operator-panel p{color:#667895;font-size:13px;line-height:1.65}.login-fields{display:grid;gap:13px}.login-fields label,.operator-panel label{display:grid;gap:7px;color:#334263;font-size:13px;font-weight:700}.login-fields input,.operator-panel input{border:1px solid #ccd8e8;border-radius:11px;padding:12px;font-size:14px}.login-fields button{width:100%;padding:13px}.login-status{grid-column:1/-1;margin:0;padding:11px 14px;border-radius:10px;background:#f3f6fc;color:#425b7d;font-size:13px}.login-status[data-state="error"]{background:#fff0ef;color:#a5221a}.login-status[data-state="success"]{background:#eaf8f2;color:#087451}.notifications-panel,.operator-panel{display:flex;align-items:center;justify-content:space-between;gap:20px;background:#f7f9fd;border:1px solid #e1e8f2;border-radius:16px;padding:18px 22px;margin:18px 0}.notifications-panel p{max-width:640px;margin:5px 0 0}.notifications-panel button,.operator-panel button{width:auto;flex-shrink:0}.operator-panel[hidden],.login-panel[hidden]{display:none}@media(max-width:720px){.login-panel{grid-template-columns:1fr;padding:18px}.notifications-panel,.operator-panel{flex-wrap:wrap}}
</style>
</body></html>