---
import "../styles/global.css";
---
<!doctype html>
<html lang="es">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Administración · IntraShop</title></head>
<body>
<header class="topbar"><a class="brand" href="/intrashop/"><img src="/intrashop-logo.svg" width="43" height="43" alt=""/><span>Intra<span class="brand-accent">Shop</span><small>ADMINISTRACIÓN</small></span></a><div style="display:flex;gap:18px"><a class="admin-back" href="/intrashop/entregas">Comandas y entregas</a><a class="admin-back" href="/intrashop/">← Volver a la tienda</a></div></header>
<main class="admin-main">
<section class="admin-heading"><span class="section-kicker">CONFIGURACIÓN LOCAL</span><h1>Administración de tienda</h1><p>Configurá la conexión con el POS. Estos datos se guardan en este dispositivo, sin servicios externos.</p></section>
<div class="admin-layout">
<section class="admin-panel"><h2>Conexión al servidor</h2><p>Usá la dirección IP del equipo que ejecuta el POS. Evitá <code>localhost</code> en tablets o TV.</p>
<div id="connection-form"><label for="totem-name">Nombre de este tótem</label><input id="totem-name" type="text" maxlength="80" required placeholder="Tótem Entrada 1"/><p class="admin-hint">Identifica este dispositivo en las comandas y permite asignarlo a cajas específicas.</p>
<label for="server-url">URL del servidor POS</label><input id="server-url" type="url" required placeholder="http://192.168.1.100:8000" autocomplete="url"/>
<button id="discover-server" type="button" class="admin-test-button">Detectar servidor cercano</button><div id="discover-results" role="status"></div>
<p class="admin-hint">La conexión al catálogo no necesita usuario, contraseña ni API key. La administración y los cobros conservan su seguridad independiente.</p>
<div class="admin-actions"><button id="save-connection" class="primary-button" type="button">Conectar y guardar</button><button id="test-connection" class="cancel-button" type="button">Probar conexión</button></div>
</div><div id="admin-status" role="status" class="admin-status"></div></section>
<section class="admin-panel"><h2>Conexión LAN</h2><p>Usá la IP de la computadora que ejecuta POS Server. El catálogo se consulta sin credenciales.</p>
<div class="admin-tip"><strong>Variables de entorno de Astro</strong><code>PUBLIC_POS_URL=http://192.168.1.100:8000</code></div>
<p class="admin-hint">No incrustes claves privadas en una compilación pública. Para producción, preferí un proxy local autenticado y dispositivos administrados.</p>
<h2>Estado del servidor</h2><div id="server-state" class="admin-server-state">Sin comprobar</div>
</section></div></main>
<footer><span class="footer-brand">IntraShop</span><span>Panel local de configuración</span><a href="/intrashop/">Ir al catálogo</a></footer>
<script is:inline>
(() => {
  const $ = (id) => document.getElementById(id);
  const makeId = () => typeof crypto !== "undefined" && typeof crypto.randomUUID === "function" ? crypto.randomUUID() : "terminal-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 12);
  const url = $("server-url"), name = $("totem-name");
  const status = $("admin-status"), state = $("server-state");
  const origin = location.port === "8000" ? location.origin : location.protocol + "//" + location.hostname + ":8000";
  const stored = localStorage.getItem("intrashop_api") || "";
  const defaultUrl = stored && !stored.includes("localhost") && !stored.includes("127.0.0.1") ? stored : origin;
  url.value = defaultUrl;

  let id = localStorage.getItem("intrashop_totem_id");
  if (!id) { id = makeId(); localStorage.setItem("intrashop_totem_id", id); }
  name.value = localStorage.getItem("intrashop_totem_name") || "Tótem " + id.slice(0, 8);
  function message(text, ok) { status.textContent = text; status.className = "admin-status " + (ok ? "success" : "error"); }
  async function request(base, path, options = {}) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), 7000);
    try {
      const response = await fetch(base + path, { ...options, signal: controller.signal });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(typeof data.detail === "string" ? data.detail : "HTTP " + response.status);
      return data;
    } finally { clearTimeout(timer); }
  }
  $("discover-server").addEventListener("click", async () => {
    const button = $("discover-server"), box = $("discover-results");
    button.disabled = true; button.textContent = "Buscando servidores…";
    const candidates = [...new Set([url.value.trim(), origin])].filter(Boolean);
    const found = await Promise.all(candidates.map(async candidate => {
      try { const data = await request(candidate.replace(/\/$/, ""), "/health"); return data.service === "pos-lan" ? candidate : null; }
      catch { return null; }
    }));
    box.replaceChildren();
    const valid = found.filter(Boolean);
    if (!valid.length) box.textContent = "No se detectó FastAPI. Revisá la IP, el puerto 8000 y el firewall del servidor.";
    for (const address of valid) {
      const option = document.createElement("button");
      option.type = "button"; option.textContent = "Seleccionar " + address;
      option.addEventListener("click", () => { url.value = address; box.textContent = "Servidor seleccionado: " + address; });
      box.append(option);
    }
    button.disabled = false; button.textContent = "Detectar servidor cercano";
  });
  $("test-connection").addEventListener("click", async () => {
    const button = $("test-connection"), base = url.value.trim().replace(/\/$/, "");
    button.disabled = true; button.textContent = "Verificando…"; state.textContent = "Comprobando conexión…";
    try {
      const health = await request(base, "/health");
      if (health.service !== "pos-lan") throw new Error("La dirección no corresponde al servidor POS.");
      const catalog = await request(base, "/tienda/productos");
      state.textContent = "Conectado · " + catalog.length + " productos";
      message("Conexión verificada. Ya podés guardar la configuración.", true);
    } catch (error) {
      state.textContent = "Sin conexión";
      message("Error de conexión: " + error.message + ". Verificá IP, API key y firewall.", false);
    } finally { button.disabled = false; button.textContent = "Probar conexión"; }
  });
  $("save-connection").addEventListener("click", async () => {
    const base = url.value.trim().replace(/\/$/, "");
    if (!/^https?:\/\//i.test(base)) { message("Ingresá una URL válida con http:// o https://", false); return; }
    const button = $("save-connection");
    button.disabled = true; button.textContent = "Guardando y verificando…";
    message("Validando conexión y registrando el tótem…", true);
    try {
      const health = await request(base, "/health");
      if (health.service !== "pos-lan") throw new Error("No es un servidor POS compatible.");
      await request(base, "/tienda/productos");
      const registration = await request(base, "/tienda/totems/register", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id, nombre: name.value.trim() }) });
      localStorage.setItem("intrashop_api", base);
      localStorage.removeItem("intrashop_key");
      localStorage.setItem("intrashop_totem_name", registration.nombre);
      state.textContent = "Conectado · tótem registrado";
      message("Tótem registrado como " + registration.nombre + ". Aparecerá en POS Server. Falta asociar un QR para cobrar.", true);
    } catch (error) {
      message("No se guardó la configuración: " + error.message + ". Revisá la IP, el puerto y que POS Server esté iniciado.", false);
    } finally { button.disabled = false; button.textContent = "Conectar y guardar"; }
  });
})();
</script></body></html>