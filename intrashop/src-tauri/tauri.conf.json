{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IntraShop",
  "version": "0.1.0",
  "identifier": "com.gestionlibreria.intrashop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4321",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IntraShop",
        "width": 1280,
        "height": 850,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http: https: data: blob:; img-src 'self' http: https: data: blob:; connect-src 'self' http: https: ws: wss:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Tienda local conectada al POS",
    "longDescription": "Catálogo y checkout local IntraShop para Gestión Librería/Kiosko."
  }
}