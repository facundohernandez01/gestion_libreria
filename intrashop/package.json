{
  "name": "intrashop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "tauri": "tauri",
    "dev:tauri": "cross-env INTRASHOP_TARGET=tauri astro dev --host 0.0.0.0",
    "build:tauri": "cross-env INTRASHOP_TARGET=tauri npm run build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.5.0",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "cross-env": "^7.0.3"
  }
}
