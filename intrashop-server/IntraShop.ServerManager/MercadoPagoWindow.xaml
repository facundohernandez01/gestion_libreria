<Window x:Class="IntraShop.ServerManager.MercadoPagoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mercado Pago - Asignaciones" Width="900" Height="620">
<Grid Margin="16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="Mercado Pago: POS y QR" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
<TextBlock Text="Usuario" VerticalAlignment="Center"/><TextBox x:Name="UserInput" Width="130" Margin="8,0,12,0"/>
<TextBlock Text="Clave" VerticalAlignment="Center"/><PasswordBox x:Name="PasswordInput" Width="130" Margin="8,0,12,0"/>
<Button Content="Ingresar" Click="Login_Click" Padding="12,5"/>
<Button Content="Actualizar" Click="Refresh_Click" Margin="8,0,0,0" Padding="12,5"/>
</StackPanel>
<TextBlock Grid.Row="2" x:Name="StatusText" Text="Ingresá con un usuario autorizado para CONFIGURACION." TextWrapping="Wrap" Margin="0,0,0,12"/>
<TabControl Grid.Row="3">
<TabItem Header="Asignaciones QR">
<Grid Margin="8">
<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DataGrid x:Name="BindingsGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single"/>
<StackPanel Grid.Row="1" Margin="0,10,0,0">
<WrapPanel>
<TextBlock Text="Terminal ID" VerticalAlignment="Center"/><TextBox x:Name="TerminalInput" Width="125" Margin="6,0,10,0"/>
<TextBlock Text="Tipo" VerticalAlignment="Center"/><ComboBox x:Name="TypeInput" Width="90" SelectedIndex="0" Margin="6,0,10,0"><ComboBoxItem Content="totem"/><ComboBoxItem Content="caja"/></ComboBox>
<TextBlock Text="Nombre" VerticalAlignment="Center"/><TextBox x:Name="NameInput" Width="150" Margin="6,0,0,0"/>
</WrapPanel>
<WrapPanel Margin="0,8,0,0">
<TextBlock Text="POS ID" VerticalAlignment="Center"/><TextBox x:Name="PosInput" Width="135" Margin="6,0,10,0"/>
<TextBlock Text="Tienda ID" VerticalAlignment="Center"/><TextBox x:Name="StoreInput" Width="135" Margin="6,0,10,0"/>
<TextBlock Text="QR URL" VerticalAlignment="Center"/><TextBox x:Name="QrInput" Width="155" Margin="6,0,8,0"/>
<Button Content="Guardar" Click="SaveBinding_Click" Padding="12,5"/>
</WrapPanel>
</StackPanel>
</Grid>
</TabItem>
<TabItem Header="POS disponibles"><DataGrid x:Name="PosGrid" Margin="8" AutoGenerateColumns="True" IsReadOnly="True"/></TabItem>
</TabControl>
<TextBlock Grid.Row="4" Text="Las credenciales OAuth permanecen en el servidor Python." Margin="0,10,0,0" Foreground="Gray"/>
</Grid>
</Window>