<Window x:Class="IntraShop.ServerManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IntraShop Server Manager" Width="740" Height="440" MinWidth="600" MinHeight="360" Background="#F7F8FA">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0"><TextBlock Text="IntraShop Server Manager" FontSize="25" FontWeight="Bold"/><TextBlock Text="Servidor local de tienda y terminales LAN" Foreground="#606875" Margin="0,6,0,18"/></StackPanel>
    <Border Grid.Row="1" Padding="16" Background="White" CornerRadius="10" BorderBrush="#DFE3EA" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="Estado del servidor" FontWeight="SemiBold" FontSize="15"/>
        <TextBlock x:Name="StatusText" Text="Comprobando…" Margin="0,8,0,10"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Puerto:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="PortInput" Width="75" Text="8000" Padding="6"/>
          <Button x:Name="StartButton" Content="Iniciar" Click="Start_Click" Margin="14,0,8,0" Padding="16,8"/>
          <Button x:Name="StopButton" Content="Detener" Click="Stop_Click" Padding="16,8"/>
          <Button Content="Abrir tienda" Click="OpenShop_Click" Margin="8,0,0,0" Padding="16,8"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Margin="0,16,0,0" Background="White" CornerRadius="10" Padding="16" BorderBrush="#DFE3EA" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="Configuración del backend" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Text="Ejecutable FastAPI (ruta absoluta)" Margin="0,12,0,4"/>
        <TextBox x:Name="BackendPathInput" Padding="8" ToolTip="Ruta de pos_server.exe empaquetado o python.exe para desarrollo"/>
        <TextBlock Text="Para desarrollo: seleccioná python.exe y configurá el directorio de trabajo del repositorio." TextWrapping="Wrap" Foreground="#606875" Margin="0,8,0,0"/>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#606875" Margin="0,18,0,0"/>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="3" Text="Versión experimental · no reemplaza al POS ni al servidor existente" Foreground="#606875" Margin="0,12,0,0"/>
  </Grid>
</Window>
