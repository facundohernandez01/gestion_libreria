# HTTPS privado GRATUITO para IntraShop + POS Server.
# 1. Usar DNS interno o /etc/hosts para resolver pos.home.arpa a la IP del POS Server.
# 2. Arrancar FastAPI con INTRASHOP_ENFORCE_HTTPS=1 y POS_PUBLIC_URL=https://pos.home.arpa.
# 3. Instalar la CA de Caddy en cada dispositivo (ver docs/https-lan.md).
#
# Caddy es el único listener de la LAN; Uvicorn solo escucha 127.0.0.1:8000.
# No habilitar el puerto 8000 ni confiar en * para forwarded headers.
pos.home.arpa {
    tls internal

    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }

    reverse_proxy 127.0.0.1:8000
}
