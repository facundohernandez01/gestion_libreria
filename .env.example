# .env.example — referencia documentada (sin secretos reales)
# Copiar con: cp .env.example .env

# Mercado Pago — panel developers https://www.mercadopago.com.ar/developers/panel
# NUNCA commitear tokens reales. Rotar si fueron expuestos en git.
MP_ACCESS_TOKEN=APP_USR-...tu-token...
MP_USER_ID=tu-user-id-numerico
MP_EXTERNAL_STORE_ID=STORE... (external_id de la tienda)
MP_EXTERNAL_POS_ID=POS... (external_id del POS con fixed_amount=true)
MP_STORE_ID=... (id numérico, se sincroniza solo)
MP_QR_URL=https://.../qr-image (opcional, se sincroniza solo)

# Negocio
NOMBRE_NEGOCIO=Mi Kiosko
CUIT=20-00000000-0
DIRECCION_NEGOCIO=Calle 123, Rosario
INGRESOS_BRUTOS=
INICIO_ACTIVIDADES=
CONDICION_IVA=Consumidor Final

# Recargo % aplicado a pagos con QR/tarjeta (feature del backup reintegrada)
RECARGO_PORCENTAJE=0

# AFIP facturación electrónica (opcional — requiere certificados en ./certificados/)
AFIP_CUIT=
AFIP_PUNTO_VENTA=1
AFIP_TIPO_FACTURA=C
AFIP_TESTING=True
# Rutas opcionales de certificado/clave (por defecto ./certificados/wsaa.crt y wsaa.key)
AFIP_CERT_FILE=
AFIP_KEY_FILE=

# Facturación automática (configurable también desde Ajustes; por defecto NO)
FACTURACION_ACTIVA=true
FACTURACION_TIPO=ticket
FACTURACION_NUMERACION_AUTOMATICA=true
FACTURACION_ULTIMO_NUMERO=0
FACTURACION_PREFIJO=TK
FACTURACION_DIR=comprobantes
FACTURAR_AUTO_QR=false
FACTURAR_AUTO_EFECTIVO=false

# App
APP_ENV=dev
DB_PATH=libreria.db
LOG_LEVEL=INFO
MP_TIMEOUT_SEG=15
MP_POLL_INTERVAL_SEG=5
MP_POLL_TIMEOUT_SEG=300

# Red / multi-usuario (FastAPI) — configurable también desde Ajustes → Red
MODO_RED=local            # local | servidor | cliente
SERVER_URL=http://127.0.0.1:8000
API_KEY=libreria-lan
API_HOST=0.0.0.0
API_PORT=8000

# Directorios de comprobantes (elegibles con el icono 📁 en Ajustes)
COMPROBANTES_DIR=comprobantes
TICKETS_DIR=tickets
